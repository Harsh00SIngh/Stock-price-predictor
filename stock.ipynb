import yfinance as yf
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout
import matplotlib.pyplot as plt
from datetime import date, timedelta
def fetch_stock_data(ticker, start_date, end_date):
data = yf.download(ticker, start=start_date, end=end_date, auto_adjust=True)
if data.empty:
print(f"No data found for '{ticker}'. Check the symbol or date range.")
return None
return data
ticker = input("Enter stock ticker (e.g., RELIANCE.NS, TCS.NS, AAPL): ").strip().upper()
start_date = input("Enter start date (YYYY-MM-DD) or press Enter for default 2020-01-01: ")
or "2020-01-01"
today = date.today()
if today.weekday() >= 5:32
offset = today.weekday() - 4
today = today - timedelta(days=offset)
end_date = today.strftime('%Y-%m-%d')
data = fetch_stock_data(ticker, start_date, end_date)
if data is not None:
data = data[['Close']]
data.dropna(inplace=True)
scaler = MinMaxScaler(feature_range=(0, 1))
scaled_data = scaler.fit_transform(data)
def create_features(df, lag=5):
df_feat = df.copy()
for i in range(1, lag + 1):
df_feat[f'lag_{i}'] = df_feat['Close'].shift(i)
df_feat.dropna(inplace=True)
return df_feat
features_df = create_features(data, lag=5)
X_ml = features_df.drop('Close', axis=1)
y_ml = features_df['Close']
X_train_ml, X_test_ml, y_train_ml, y_test_ml = train_test_split(X_ml, y_ml, test_size=0.2,
random_state=42)
ml_model = LinearRegression()
ml_model.fit(X_train_ml, y_train_ml)
ml_pred = ml_model.predict(X_test_ml)
ml_rmse = np.sqrt(mean_squared_error(y_test_ml, ml_pred))
print(f"ML Model RMSE: {ml_rmse:.4f}")
def create_sequences(data, seq_length):
X, y = [], []
for i in range(len(data) - seq_length):33
X.append(data[i:i + seq_length])
y.append(data[i + seq_length])
return np.array(X), np.array(y)
seq_length = 60
X_dl, y_dl = create_sequences(scaled_data, seq_length)
X_train_dl, X_test_dl, y_train_dl, y_test_dl = train_test_split(X_dl, y_dl, test_size=0.2,
random_state=42)
dl_model = Sequential([
LSTM(50, return_sequences=True, input_shape=(seq_length, 1)),
Dropout(0.2),
LSTM(50, return_sequences=False),
Dropout(0.2),
Dense(1)
])
dl_model.compile(optimizer='adam', loss='mean_squared_error')
dl_model.fit(X_train_dl, y_train_dl, epochs=20, batch_size=32, verbose=1)
dl_pred_scaled = dl_model.predict(X_test_dl)
dl_pred = scaler.inverse_transform(dl_pred_scaled)
y_test_actual = scaler.inverse_transform(y_test_dl.reshape(-1, 1))
dl_rmse = np.sqrt(mean_squared_error(y_test_actual, dl_pred))
print(f"LSTM Model RMSE: {dl_rmse:.4f}")
last_seq = scaled_data[-seq_length:].reshape(1, seq_length, 1)
next_pred_scaled = dl_model.predict(last_seq)
next_pred = scaler.inverse_transform(next_pred_scaled)
print(f"Predicted next day's closing price for {ticker}: {next_pred[0][0]:.2f}")
plt.figure(figsize=(14, 7))
plt.plot(y_test_actual, label='Actual Prices', color='blue')
plt.plot(dl_pred, label='LSTM Predictions', color='red')
plt.plot(ml_pred[-len(y_test_actual):], label='Linear Regression Predictions', color='green')
plt.title(f'Stock Price Prediction for {ticker}')34
plt.xlabel('Days')
plt.ylabel('Price')
plt.legend()
plt.show()
else:
print("No data fetched.")
